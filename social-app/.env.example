NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/social-app

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-please
JWT_REFRESH_SECRET=change-me-refresh-secret-please
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

OTP_TTL_MINUTES=10

# Google OAuth 2.0 (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# SMTP (leave SMTP_HOST empty in dev -> emails are printed in the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Social App <no-reply@socialapp.dev>"
